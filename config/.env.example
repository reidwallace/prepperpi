# Per-machine PrepperPi settings
# Copy to config/.env and edit values

STORAGE_PROFILE="minimal"
DOWNLOAD_LIMIT=""

# Network (set these for your machine)
PI_IP=""
SUBNET=""
WIFI_PSK=""

# System
PI_HOSTNAME="prepperpi"
PI_TIMEZONE="America/Chicago"
PI_LOCALE="en_US.UTF-8"

# Ports
KIWIX_PORT="8080"
WEBAPP_PORT="5001"

# Services (true/false)
ENABLE_KIWIX="true"
ENABLE_UPDATE_TIMER="true"
ENABLE_BACKUP_TIMER="false"
ENABLE_MONITOR="false"
