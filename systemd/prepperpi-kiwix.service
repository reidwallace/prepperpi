[Unit]
Description=PrepperPi Kiwix Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/prepperpi/data
EnvironmentFile=-/opt/prepperpi/config/.env
ExecStart=/usr/bin/kiwix-serve -p ${KIWIX_PORT} --library /opt/prepperpi/data/library.xml
Environment=KIWIX_PORT=8080
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
